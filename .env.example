# LLM (Gemini). Required once USE_MOCK=false.
GEMINI_API_KEY=

# Web search: Tavily primary, SerpAPI fallback. Optional while mock mode is on.
TAVILY_API_KEY=
SERPAPI_API_KEY=

# true = mock LLM + mock search, no keys needed (default for Phases 1-7)
USE_MOCK=true

# LLM model id (Gemini default; overridable)
LLM_MODEL=gemini-2.5-flash

LOG_LEVEL=INFO
